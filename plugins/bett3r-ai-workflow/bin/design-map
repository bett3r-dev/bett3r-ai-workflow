#!/bin/sh
# Launcher for scripts/design-map.py — the map verbs: `render` turns a design's
# map.json into the self-contained page its owner answers forks on, refusing
# when the payload's fork count differs from `--expect` or the page drops a
# fork. Ends in a `DESIGN-MAP:v1` verdict line.
#
# Mirrors `work-docs-path`, for the same reason as `lane-step`: `CLAUDE_PLUGIN_ROOT`
# is substituted for hook invocations only, while every enabled plugin's `bin/`
# is on `PATH`, keyed by the version the session loaded.
exec python3 "$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)/scripts/design-map.py" "$@"
