#!/bin/sh
# Launcher for scripts/worktree-pool.py — the git mechanics of /build's worktree
# pool (size, provision, reset, land, teardown), each ending in a
# `WORKTREE-POOL:v1` verdict line.
#
# Here for the same reason as `lane-step`: `CLAUDE_PLUGIN_ROOT` is substituted for
# hook invocations only, while every enabled plugin's `bin/` is on `PATH`, keyed
# by the version the session loaded.
exec python3 "$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)/scripts/worktree-pool.py" "$@"
