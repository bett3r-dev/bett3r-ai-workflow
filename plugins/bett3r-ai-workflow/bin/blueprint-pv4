#!/usr/bin/env python3
"""Sign this laptop in to a Blueprint (pv4) tenant and connect a checkout to its session.

  blueprint-pv4 login --host <url>     sign in by device code as the client blueprint-cli
  blueprint-pv4 logout [--host <url>]  sign the token out on its host and forget it
  blueprint-pv4 whoami [--host <url>] [--token]
                                       who the stored token acts as; --token prints the token
  blueprint-pv4 connect [--host <url>] [--session <id>]
                                       record the session of this checkout's branch
  blueprint-pv4 status                 the record's host and session, the sign-in, the attachment
  blueprint-pv4 disconnect             remove the record

login is RFC 8628 against pv4's device sign-in (POST /_pv4/device/code, then polls POST
/_pv4/device/token, pv4 web/device.go); the pv4s_ token is kept owner-only (0600) in
~/.config/blueprint-pv4/credentials.json as {"hosts": {"<scheme://host[:port]>": {"token"}}}.

connect reads GET /api/session_engine/hub-cards?repository=<host/owner/repo>&discarded=false
with the token as Bearer and keeps the cards whose branch is the checkout's: one is written
to $(git rev-parse --git-dir)/blueprint-pv4-connection.json as {host, sessionId,
branchAtConnect, connectedAt, repository}; several print CONNECT_SEVERAL listing them, none
prints CONNECT_NO_SESSION; neither writes a record, and nothing is started on the host.
--session <id> records the session the host lists under that id, whatever its branch.

Refusals print one line starting with their code (CONNECT_NO_SESSION, CONNECT_SEVERAL,
CONNECT_NOT_SIGNED_IN, CONNECT_NO_ORIGIN, CONNECT_HOST_REQUIRED) and exit 1; a usage error
exits 2. The TS /blueprint command's blueprint-connection.json is never read or written.
"""

import argparse
import datetime
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

CLIENT_ID = "blueprint-cli"
DEVICE_CODE_PATH = "/_pv4/device/code"
DEVICE_TOKEN_PATH = "/_pv4/device/token"
SESSION_PATH = "/_pv4/session"
SIGN_OUT_PATH = "/_pv4/sign-out"
HUB_CARDS_PATH = "/api/session_engine/hub-cards"
DEVICE_GRANT = "urn:ietf:params:oauth:grant-type:device_code"
TOKEN_PREFIX = "pv4s_"
RECORD = "blueprint-pv4-connection.json"
TIMEOUT = 10


class Refused(Exception):
    """A refusal: one line, its code first, exit 1."""


# ---- where things are -------------------------------------------------------

def credentials_path():
    home = os.environ.get("HOME") or os.path.expanduser("~")
    return os.path.join(home, ".config", "blueprint-pv4", "credentials.json")


def origin_of(url):
    """A host as the credentials key it: scheme://host[:port], no path, no trailing slash."""
    parts = urllib.parse.urlsplit(url.strip())
    if parts.scheme not in ("http", "https") or not parts.netloc:
        raise Refused("LOGIN_BAD_HOST: %r is not an http(s) URL such as https://acme.blueprint.example" % url)
    return "%s://%s" % (parts.scheme, parts.netloc)


def load_credentials():
    try:
        with open(credentials_path(), encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        return {"hosts": {}}
    if not isinstance(data, dict) or not isinstance(data.get("hosts"), dict):
        return {"hosts": {}}
    return data


def save_credentials(data):
    """Write owner-only: the directory 0700, the file 0600, replaced atomically."""
    path = credentials_path()
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = "%s.%d.tmp" % (path, os.getpid())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2)
            f.write("\n")
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def signed_in_host(host):
    """(host, token) for --host, else the one host signed in to; refused otherwise."""
    hosts = load_credentials()["hosts"]
    if host:
        key = origin_of(host)
        token = (hosts.get(key) or {}).get("token")
        if not token:
            raise Refused("CONNECT_NOT_SIGNED_IN: this laptop is not signed in to %s; run `blueprint-pv4 login --host %s`" % (key, key))
        return key, token
    signed = sorted(k for k, v in hosts.items() if isinstance(v, dict) and v.get("token"))
    if not signed:
        raise Refused("CONNECT_NOT_SIGNED_IN: this laptop is signed in to no Blueprint host; run `blueprint-pv4 login --host <url>`")
    if len(signed) > 1:
        raise Refused("CONNECT_HOST_REQUIRED: this laptop is signed in to %s; name one with --host" % ", ".join(signed))
    return signed[0], hosts[signed[0]]["token"]


def git(*args):
    try:
        out = subprocess.run(["git"] + list(args), capture_output=True, text=True, check=False)
    except OSError:
        return ""
    return out.stdout.strip() if out.returncode == 0 else ""


def repository_of(remote):
    """The origin URL as Blueprint keys a repository, mirroring its Go
    PlainRepository (modules/branch_overrides/domain/repository.go): host and
    path, lower case, with no scheme, user, scp ':' or .git; a port is kept.
    git@github.com:Acme/Shop.git and https://github.com/acme/shop are both
    github.com/acme/shop. HubCards filters on that spelling exactly."""
    r = remote.strip()
    i = r.find("://")
    if i >= 0:
        r = r[i + 3:]
    else:
        at = r.find("@")
        if at >= 0:  # scp form: user@host:path
            r = r[at + 1:].replace(":", "/", 1)
    at = r.find("@")
    if 0 <= at < (r + "/").find("/"):
        r = r[at + 1:]
    r = r.rstrip("/")
    if r.endswith(".git"):
        r = r[:-4]
    return r.lower().rstrip("/")


# ---- talking to the host ----------------------------------------------------

def request(method, url, token=None, form=None):
    """(status, parsed JSON body or {}); an unreachable host raises Refused."""
    data = urllib.parse.urlencode(form).encode() if form is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Accept", "application/json")
    if data is not None:
        req.add_header("Content-Type", "application/x-www-form-urlencoded")
    if token:
        req.add_header("Authorization", "Bearer " + token)
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as res:
            status, raw = res.status, res.read()
    except urllib.error.HTTPError as e:
        status, raw = e.code, e.read()
    except (urllib.error.URLError, OSError) as e:
        raise Refused("UNREACHABLE: %s did not answer (%s)" % (url, getattr(e, "reason", e)))
    try:
        body = json.loads(raw) if raw else {}
    except ValueError:
        body = {}
    return status, body


def hub_cards(host, token, query):
    status, rows = request("GET", host + HUB_CARDS_PATH + "?" + urllib.parse.urlencode(query), token)
    if status == 401:
        raise Refused("CONNECT_NOT_SIGNED_IN: %s no longer takes this laptop's sign-in; run `blueprint-pv4 login --host %s`" % (host, host))
    if status != 200 or not isinstance(rows, list):
        message = rows.get("message", "") if isinstance(rows, dict) else ""
        raise Refused("CONNECT_FAILED: %s answered %d reading its sessions%s" % (host, status, ": " + message if message else ""))
    return [r for r in rows if isinstance(r, dict)]


# ---- the commands -----------------------------------------------------------

def cmd_login(args):
    host = origin_of(args.host)
    status, code = request("POST", host + DEVICE_CODE_PATH, form={"client_id": CLIENT_ID})
    if status != 200 or not code.get("device_code"):
        raise Refused("LOGIN_FAILED: %s answered %d to the device code: %s" % (host, status, code.get("error_description") or code.get("error") or ""))
    print("To sign this laptop in, open %s" % (code.get("verification_uri_complete") or code.get("verification_uri")))
    print("and approve the code %s." % code.get("user_code"), flush=True)
    interval = int(code.get("interval", 5))
    deadline = time.monotonic() + int(code.get("expires_in", 600))
    while time.monotonic() < deadline:
        time.sleep(interval)
        status, answer = request("POST", host + DEVICE_TOKEN_PATH, form={
            "grant_type": DEVICE_GRANT, "device_code": code["device_code"], "client_id": CLIENT_ID})
        error = answer.get("error")
        if status == 200 and str(answer.get("access_token", "")).startswith(TOKEN_PREFIX):
            data = load_credentials()
            data["hosts"][host] = {"token": answer["access_token"],
                                   "signedInAt": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")}
            save_credentials(data)
            print("Signed in to %s." % host)
            return 0
        if error == "authorization_pending":
            continue
        if error == "slow_down":
            interval += 5
            continue
        raise Refused("LOGIN_FAILED: %s: %s" % (error or status, answer.get("error_description", "no pv4s_ token in the answer")))
    raise Refused("LOGIN_FAILED: the code expired before it was approved; run login again")


def cmd_logout(args):
    host, token = signed_in_host(args.host)
    request("POST", host + SIGN_OUT_PATH, token)  # best effort: the token is forgotten either way
    data = load_credentials()
    data["hosts"].pop(host, None)
    save_credentials(data)
    print("Signed out of %s." % host)
    return 0


def cmd_whoami(args):
    host, token = signed_in_host(args.host)
    if args.token:
        print(token)
        return 0
    status, who = request("GET", host + SESSION_PATH, token)
    if status != 200:
        raise Refused("CONNECT_NOT_SIGNED_IN: %s answered %d for this laptop's sign-in; run `blueprint-pv4 login --host %s`" % (host, status, host))
    print("%s on %s (role %s, via %s)" % (who.get("actor"), host, who.get("role"), who.get("method")))
    return 0


def checkout():
    """(git dir, repository, branch) of the current directory; refused without an origin."""
    git_dir = git("rev-parse", "--absolute-git-dir")
    remote = git("config", "--get", "remote.origin.url") if git_dir else ""
    repository = repository_of(remote) if remote else ""
    if not repository:
        raise Refused("CONNECT_NO_ORIGIN: this directory is not a git checkout with an origin remote")
    if repository[0] in "/~." or "/" not in repository:
        # Blueprint's RepositoryProblem: a folder, or no host/owner/name, names
        # no repository it can reach, so no hub card can be on it.
        raise Refused("CONNECT_NO_ORIGIN: origin %s is not a git URL Blueprint can reach" % remote)
    return git_dir, repository, git("symbolic-ref", "--short", "-q", "HEAD")


def describe(card):
    return "%s  %s  (%s, branch %s)" % (card.get("id"), card.get("name") or "(unnamed)", card.get("column"), card.get("branch"))


def cmd_connect(args):
    git_dir, repository, branch = checkout()
    host, token = signed_in_host(args.host)
    if args.session:
        cards = hub_cards(host, token, {"id": args.session})
    else:
        if not branch:
            raise Refused("CONNECT_NO_SESSION: this checkout is on no branch; check one out, or connect with --session <id>")
        cards = hub_cards(host, token, {"repository": repository, "discarded": "false"})
        cards = [c for c in cards if c.get("branch") == branch]
    if not cards:
        if args.session:
            raise Refused("CONNECT_NO_SESSION: %s lists no session %s that you can see" % (host, args.session))
        raise Refused("CONNECT_NO_SESSION: %s has no session on %s branch %s; start one on the hub, then connect again" % (host, repository, branch))
    if len(cards) > 1:
        raise Refused("CONNECT_SEVERAL: %d sessions on %s branch %s; pick one with `blueprint-pv4 connect --session <id>`:\n%s"
                      % (len(cards), repository, branch, "\n".join("  " + describe(c) for c in cards)))
    card = cards[0]
    record = {"host": host, "sessionId": card["id"], "branchAtConnect": branch,
              "connectedAt": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"),
              "repository": repository}
    with open(os.path.join(git_dir, RECORD), "w", encoding="utf-8") as f:
        json.dump(record, f, indent=2)
        f.write("\n")
    print("Connected this checkout to %s" % describe(card))
    print("on %s." % host)
    return 0


def read_record():
    git_dir = git("rev-parse", "--absolute-git-dir")
    if not git_dir:
        return "", None
    try:
        with open(os.path.join(git_dir, RECORD), encoding="utf-8") as f:
            record = json.load(f)
    except (OSError, ValueError):
        return git_dir, None
    return git_dir, record if isinstance(record, dict) else None


def cmd_status(args):
    _, record = read_record()
    if not record:
        print("host: none")
        print("session: none (run `blueprint-pv4 connect`)")
    else:
        print("host: %s" % record.get("host"))
        print("session: %s (branch at connect %s, %s, connected %s)" % (
            record.get("sessionId"), record.get("branchAtConnect"), record.get("repository"), record.get("connectedAt")))
    hosts = load_credentials()["hosts"]
    host = record.get("host") if record else None
    if host:
        print("signed in: %s" % ("yes" if (hosts.get(host) or {}).get("token") else "no (run `blueprint-pv4 login --host %s`)" % host))
    else:
        print("signed in: %s" % (", ".join(sorted(hosts)) or "nowhere"))
    # The laptop's attachment (AttachLaptop's lease) is the listener's; no listener runs here yet.
    print("attachment: none")
    return 0


def cmd_disconnect(args):
    git_dir, record = read_record()
    if not git_dir:
        raise Refused("CONNECT_NO_ORIGIN: this directory is not a git checkout")
    try:
        os.unlink(os.path.join(git_dir, RECORD))
    except FileNotFoundError:
        print("This checkout was not connected.")
        return 0
    print("Disconnected this checkout from session %s." % (record or {}).get("sessionId"))
    return 0


def parser():
    p = argparse.ArgumentParser(prog="blueprint-pv4", description="Sign this laptop in to Blueprint (pv4) and connect a checkout to its session.")
    sub = p.add_subparsers(dest="command", required=True)
    s = sub.add_parser("login", help="sign in by device code")
    s.add_argument("--host", required=True)
    s.set_defaults(run=cmd_login)
    s = sub.add_parser("logout", help="sign out and forget the token")
    s.add_argument("--host")
    s.set_defaults(run=cmd_logout)
    s = sub.add_parser("whoami", help="who the stored token acts as")
    s.add_argument("--host")
    s.add_argument("--token", action="store_true", help="print the stored token alone")
    s.set_defaults(run=cmd_whoami)
    s = sub.add_parser("connect", help="record the session of this checkout's branch")
    s.add_argument("--host")
    s.add_argument("--session", help="record this session id, whatever its branch")
    s.set_defaults(run=cmd_connect)
    s = sub.add_parser("status", help="the record, the sign-in and the attachment")
    s.set_defaults(run=cmd_status)
    s = sub.add_parser("disconnect", help="remove the record")
    s.set_defaults(run=cmd_disconnect)
    return p


def main(argv):
    args = parser().parse_args(argv)
    try:
        return args.run(args)
    except Refused as e:
        print(str(e))
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
